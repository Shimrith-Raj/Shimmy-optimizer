{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shimmy spike",
  "version": "0.1.0",
  "identifier": "com.shimmy.optimizer.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "title": "Shimmy spike",
        "width": 720,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}